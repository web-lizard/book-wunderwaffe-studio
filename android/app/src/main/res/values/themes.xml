<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BookWunderwaffePocket" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="PocketText">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="PocketButton" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="PocketButton.Primary" parent="PocketButton">
        <item name="android:textColor">#FFF7FF</item>
        <item name="android:background">@drawable/button_primary</item>
    </style>

    <style name="PocketInput" parent="PocketText">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
</resources>
