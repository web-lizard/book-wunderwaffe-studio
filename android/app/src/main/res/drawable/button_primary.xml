<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7450CC" android:endColor="#A657DC" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent_deep" android:endColor="@color/accent" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
